{
  "name": "sistema-inventario-tienda",
  "version": "1.0.9",
  "description": "Sistema de inventario para tienda con módulos de inventario, ventas, entradas y corte de caja",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --win",
    "reset-db": "node reset-db.js"
  },
  "keywords": [
    "inventario",
    "tienda",
    "pos",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/1230235-cloud/tienda-cvs.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "bonjour": "^3.5.1",
    "cors": "^2.8.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.tienda.inventario",
    "productName": "SistemaInventario",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sqlite3/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "!dist/**",
      "!data/**",
      "!test/**",
      "!tests/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "1230235-cloud",
        "repo": "tienda-cvs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Inventario Tienda CVS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-portable.${ext}"
    }
  }
}
