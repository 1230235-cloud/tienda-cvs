{
  "name": "sistema-inventario-tienda",
  "version": "1.0.0",
  "description": "Sistema de inventario para tienda con módulos de inventario, ventas, entradas y corte de caja",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --win"
  },
  "keywords": [
    "inventario",
    "tienda",
    "pos",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sharp": "^0.35.3",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-updater": "^6.8.9",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.tienda.inventario",
    "productName": "SistemaInventario",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!data/**",
      "!node_modules/**"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Inventario Tienda CVS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
